# Bluetooth speaker as a named ALSA device, via BlueALSA (README: "Bluetooth speaker").
# Copy to /etc/asound.conf, put your speaker's MAC in `device`, then set
# AUDIO_OUT_DEVICE=bologna in /etc/lastscene/device.env.
# plug converts what aplay sends (16 kHz / 24 kHz mono) to the speaker format (48 kHz stereo).
pcm.bologna {
    type plug
    slave.pcm {
        type bluealsa
        device "04:21:44:E0:FC:AD"
        profile "a2dp"
    }
    hint.description "Sony SRS-XB12 (bologna) over Bluetooth"
}
ctl.bologna {
    type bluealsa
}
