[Unit]
Description=LastScene wearable client
After=network-online.target sound.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/lastscene/device.env
# The venv sees apt packages (picamera2, gpiozero, httpx) and adds openwakeword (README step 3)
ExecStart=/opt/lastscene/venv/bin/python /opt/lastscene/lastscene_device.py
Restart=always
RestartSec=5
# Dedicated user with just GPIO, camera and audio access
User=lastscene
SupplementaryGroups=gpio video audio netdev
# Lets the iw fallback scan Wi-Fi without running as root
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
