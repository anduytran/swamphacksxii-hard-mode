# LastScene wearable config. Copy to /etc/lastscene/device.env (chmod 600).
API_URL=https://www.lastscene.photo
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.lastscene
# The "Wearable" Machine-to-Machine app in Auth0 (never the dashboard SPA)
DEVICE_CLIENT_ID=
DEVICE_CLIENT_SECRET=

# BCM GPIO numbers
REMEMBER_PIN=17
ASK_PIN=27
LED_PIN=22

# ALSA devices (see arecord -l / aplay -l). The Voice Bonnet is card 1: its mics and its speaker are both
# plughw:1,0 (README "Voice Bonnet mic"). "default" works for a USB dongle that is the only sound card.
AUDIO_IN_DEVICE=default
AUDIO_OUT_DEVICE=default
MAX_RECORD_SECONDS=15

# Wake phrase (optional): say "Last Scene", then speak; the server decides remember vs question.
# WAKE_WORD is the "Last Scene" openWakeWord model that ships in device/wake/ (README step 4 copies it).
# hey_jarvis also works, as a stand-in. Empty = buttons only.
WAKE_WORD=/opt/lastscene/wake/last_scene.onnx
WAKE_THRESHOLD=0.6
WAKE_MAX_SECONDS=10
# The wake phrase as a command: always listening on the Pi (nothing leaves it until the wake model fires).
# Then photo 1 at once, record until you stop, WAKE_PHOTOS - 1 more photos WAKE_PHOTO_GAP_SECONDS apart, and
# one request: the server confirms "Last Scene" with speech-to-text (false wakes are dropped silently) and a
# low-reasoning model decides remember / ask / found from the words and picks the photo that shows the item.
# WAKE_PREROLL_SECONDS of audio from before the wake is kept so the clip holds the phrase itself.
WAKE_CONFIRM=true
WAKE_PHOTOS=4
WAKE_PHOTO_GAP_SECONDS=0.75
WAKE_PREROLL_SECONDS=2.0

# Speech-to-text on the Pi (README step 3): moonshine (default model: /opt/lastscene/stt/moonshine-tiny),
# vosk (/opt/lastscene/stt/vosk-model-small-en-us-0.15), or server (send the audio). STT_MODEL overrides
# the folder. STT_FALLBACK=true sends the audio when the local model is missing or hears nothing;
# false means the recording never leaves the Pi.
STT_ENGINE=moonshine
STT_MODEL=
STT_FALLBACK=true

# Live conversation (optional; needs `pip install google-genai` on the Pi and LIVE_ENABLED=true
# on the server): the wake phrase, or holding ASK quietly for LIVE_HOLD_SECONDS, starts a spoken
# back-and-forth with Gemini Live. It ends after LIVE_SILENCE_SECONDS with nobody talking, after
# LIVE_MAX_SECONDS, or on any button press. If it can't start, the one-shot flow above is used.
LIVE=false
LIVE_MAX_SECONDS=90
LIVE_SILENCE_SECONDS=8
LIVE_HOLD_SECONDS=2
SPOOL_DIR=/var/lib/lastscene/spool

# Item detection on the device (optional; README "Item detection on the device"). The vision pipeline's model
# runs in this same service: a statement's photo is retried (CAPTURE_RETRIES more, RETRY_GAP_SECONDS apart)
# until the item you named is in it, and between conversations a frame every VISION_EVERY seconds is checked
# when the scene changed (MOTION_THRESHOLD, 0-255). VISION_EVERY=0 = voice commands only.
# VISION_DIR is the repo's vision/ folder; the model is LASTSCENE_DATA/models/current (lastscene_pipeline.fetch).
VISION_DIR=
LASTSCENE_DATA=/var/lib/lastscene/vision
# auto: a Camera Module if one is connected, else the USB camera at /dev/video<CAMERA_INDEX>
CAMERA=auto
CAMERA_INDEX=0
# Two-Pi wearable (README "Two Pis"): on the audio Pi, CAMERA=remote and the camera Pi's address and token.
# One request per memory; questions never ask for a photo. Make a token: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CAMERA_URL=
CAMERA_TOKEN=
MIN_CONFIDENCE=0.35
CAPTURE_RETRIES=3
RETRY_GAP_SECONDS=1.0
VISION_EVERY=2
MOTION_THRESHOLD=4
# Sent with background observations: where the wearer usually is, in the room's words
SCENE_LABEL=

# Pairing: the code a caregiver types in the dashboard (Household → Claim device) along
# with DEVICE_CLIENT_ID. Generate one per device and stick it on the case:
#   python3 -c "import secrets; print('-'.join(secrets.token_hex(2).upper() for _ in range(3)))"
PAIRING_CODE=

# Where memories happened. wifi: scan nearby access points (the server looks up the
# position; needs GOOGLE_GEOLOCATION_API_KEY on the server). fixed: always HOME_LAT/LNG.
LOCATION_SOURCE=wifi
WIFI_INTERFACE=wlan0
# Optional: used when LOCATION_SOURCE=fixed, and as a fallback when Wi-Fi gives no fix
HOME_LAT=
HOME_LNG=
