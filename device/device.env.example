# LastScene wearable config. Copy to /etc/lastscene/device.env (chmod 600).
API_URL=https://www.lastscene.photo
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.lastscene
# The "Wearable" Machine-to-Machine app in Auth0 (never the dashboard SPA)
DEVICE_CLIENT_ID=
DEVICE_CLIENT_SECRET=

# BCM GPIO numbers
REMEMBER_PIN=17
ASK_PIN=27
LED_PIN=22

# ALSA devices: "default", or e.g. plughw:1,0 for a USB dongle (see arecord -l / aplay -l)
AUDIO_IN_DEVICE=default
AUDIO_OUT_DEVICE=default
MAX_RECORD_SECONDS=15

# Wake phrase (optional): say "Last Scene", then speak; the server decides remember vs question.
# WAKE_WORD is the "Last Scene" openWakeWord model that ships in device/wake/ (README step 4 copies it).
# hey_jarvis also works, as a stand-in. Empty = buttons only.
WAKE_WORD=/opt/lastscene/wake/last_scene.onnx
WAKE_THRESHOLD=0.6
WAKE_MAX_SECONDS=10

# Speech-to-text on the Pi (README step 3): moonshine (default model: /opt/lastscene/stt/moonshine-tiny),
# vosk (/opt/lastscene/stt/vosk-model-small-en-us-0.15), or server (send the audio). STT_MODEL overrides
# the folder. STT_FALLBACK=true sends the audio when the local model is missing or hears nothing;
# false means the recording never leaves the Pi.
STT_ENGINE=moonshine
STT_MODEL=
STT_FALLBACK=true

# Live conversation (optional; needs `pip install google-genai` on the Pi and LIVE_ENABLED=true
# on the server): the wake phrase, or holding ASK quietly for LIVE_HOLD_SECONDS, starts a spoken
# back-and-forth with Gemini Live. It ends after LIVE_SILENCE_SECONDS with nobody talking, after
# LIVE_MAX_SECONDS, or on any button press. If it can't start, the one-shot flow above is used.
LIVE=false
LIVE_MAX_SECONDS=90
LIVE_SILENCE_SECONDS=8
LIVE_HOLD_SECONDS=2
SPOOL_DIR=/var/lib/lastscene/spool

# Pairing: the code a caregiver types in the dashboard (Household → Claim device) along
# with DEVICE_CLIENT_ID. Generate one per device and stick it on the case:
#   python3 -c "import secrets; print('-'.join(secrets.token_hex(2).upper() for _ in range(3)))"
PAIRING_CODE=

# Where memories happened. wifi: scan nearby access points (the server looks up the
# position; needs GOOGLE_GEOLOCATION_API_KEY on the server). fixed: always HOME_LAT/LNG.
LOCATION_SOURCE=wifi
WIFI_INTERFACE=wlan0
# Optional: used when LOCATION_SOURCE=fixed, and as a fallback when Wi-Fi gives no fix
HOME_LAT=
HOME_LNG=
