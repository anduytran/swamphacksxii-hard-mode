# Copy to .env (never commit .env) or set these in your shell / service config.
# Nothing is uploaded until LASTSCENE_API_BASE is set.
LASTSCENE_API_BASE=
LASTSCENE_PAIRING_CODE=

# Auth0 machine-to-machine application (same device credential the wearable uses)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Development only, instead of the four AUTH0_* values:
# LASTSCENE_DEVICE_TOKEN=

# Training on Vultr (python -m lastscene_pipeline.vultr ... --env-file .env), on this laptop only: the
# training server never gets this key. The pipeline reads API_URL, DEVICE_CLIENT_ID, DEVICE_CLIENT_SECRET
# and PAIRING_CODE (the bridge accepts those names too), plus AUTH0_DOMAIN and AUTH0_AUDIENCE above.
VULTR_API_KEY=
