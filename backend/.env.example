# --- Auth0 ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.lastscene
AUTH0_SPA_CLIENT_ID=spa-client-id-from-auth0
DEVICE_SCOPE=write:memories
# Optional: require this RBAC permission on caregiver tokens (e.g. read:history)
CAREGIVER_PERMISSION=

# --- TigerData (Postgres + pgvector) ---
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# --- Photo links ---
# Signs the short-lived photo URLs the dashboard loads. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IMAGE_URL_SECRET=

# --- AI providers ---
# Gemini runs every stage by default: speech-to-text, embeddings, answers,
# item extraction, photo descriptions, caregiver summaries and text-to-speech.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Live conversation mode (optional): POST /api/v1/live/token mints a one-use Gemini Live
# token for the wearable (the key above never leaves the server). The model, persona, tools
# and GEMINI_TTS_VOICE are locked into each token. Off = 404, and the device uses /memory/voice.
LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_TOKENS_PER_HOUR=30

# Per-stage providers: gemini, or the originals (openai / claude). Changing
# EMBEDDING_PROVIDER makes already-stored memories unsearchable until re-logged.
STT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
TTS_PROVIDER=gemini
VISION_PROVIDER=gemini

# Only needed if a stage above is switched back to them
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
TTS_FORMAT=wav

# --- Wi-Fi positioning ---
# The wearable sends nearby Wi-Fi access points; the server asks Google's Geolocation
# API where that is (Google Cloud → enable "Geolocation API" → API key). Paid beyond the
# free tier; empty = no positions except a fixed HOME_LAT/LNG sent by the device.
GOOGLE_GEOLOCATION_API_KEY=
# Spend guard: Google calls allowed per calendar month (UTC); past it, Wi-Fi positioning pauses
# until next month. Keep it under Google's free monthly allowance. 0 = off.
GEOLOCATION_MONTHLY_LIMIT=5000
# Cached answers per access-point set are reused for this many days (free repeat lookups).
GEOLOCATION_CACHE_DAYS=30

# Name public places ("Starbucks, Reitz Union") on the dashboard with Gemini's Grounding with
# Google Maps (uses GEMINI_API_KEY). 5,000 free requests a month, then billed: off by default.
# Only places a household marked public are sent, in the background, cached by position.
MAPS_GROUNDING=false
# At most this many calls a day across the app (50 x 31 days stays under the free 5,000).
MAPS_DAILY_LIMIT=50
MAPS_CACHE_DAYS=180

# --- Vision pipeline observations ---
# Controlled m960d laptop demo: override to 0.05 on the backend; keep Maybe at 0.5.
# This filter affects all devices/labels. See ../docs/bridge-integration.md.
MIN_DETECTION_CONFIDENCE=0.35
MAYBE_CONFIDENCE=0.5
OBSERVATION_MIN_INTERVAL_SECONDS=2
# Last-seen frame per item; 72 = same as memories, 720 = the proposed 30 days
LAST_SEEN_RETENTION_HOURS=72

# --- Serverless (Vercel) ---
# false = enrich before responding (safer when the host may freeze after a response)
ENRICH_IN_BACKGROUND=true
# Vercel Cron sends this as a bearer token to /api/v1/admin/purge
CRON_SECRET=

# --- Data lifecycle ---
RETENTION_HOURS=72
