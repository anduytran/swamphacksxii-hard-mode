# --- Auth0 ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.lastscene
AUTH0_SPA_CLIENT_ID=spa-client-id-from-auth0
DEVICE_SCOPE=write:memories
# Optional: require this RBAC permission on caregiver tokens (e.g. read:history)
CAREGIVER_PERMISSION=

# --- TigerData (Postgres + pgvector) ---
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# --- Photo links ---
# Signs the short-lived photo URLs the dashboard loads. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IMAGE_URL_SECRET=

# --- AI providers ---
# Gemini runs every stage by default: speech-to-text, embeddings, answers,
# item extraction, photo descriptions, caregiver summaries and text-to-speech.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Cheapest models with the biggest free quotas first; a call moves down the list when a model
# is at its limit, cooling down, overloaded or down (embeddings never switch models).
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash,gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Live conversation mode (optional): POST /api/v1/live/token mints a one-use Gemini Live
# token for the wearable (the key above never leaves the server). The model, persona, tools
# and GEMINI_TTS_VOICE are locked into each token. Off = 404, and the device uses /memory/voice.
LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_TOKENS_PER_HOUR=30

# Per-stage providers: gemini, or the originals (openai / claude). Changing
# EMBEDDING_PROVIDER makes already-stored memories unsearchable until re-logged.
STT_PROVIDER=gemini  # or elevenlabs (Scribe, below); Gemini stays the fallback
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=gemini
TTS_PROVIDER=gemini  # or elevenlabs (below); Gemini speech stays the fallback

# ElevenLabs voice for the wearable (TTS_PROVIDER=elevenlabs). Key: elevenlabs.io > Developers >
# API keys (text-to-speech permission is enough). Billed in characters: capped per month here and
# never past what your plan has left (a reserve is kept); anything that fails falls back to Gemini.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww  # River (relaxed, calm); Sarah EXAVITQu4vr4xnSDxMaL, George JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=0.9
ELEVENLABS_MONTHLY_CHARS=120000  # keep under your plan (Creator: 131,000/month)
ELEVENLABS_RESERVE_CHARS=500
ELEVENLABS_RPM=20
# ElevenLabs speech-to-text (STT_PROVIDER=elevenlabs): Scribe v2, ~0.5 s for a short clip, billed per hour
# of audio (not the voice's characters). Capped in seconds of audio a month; failures fall back to Gemini.
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_MONTHLY_SECONDS=36000
ELEVENLABS_STT_RPM=30
# Hints for speech-to-text, either provider: "Last Scene" plus the household's Teach items and aliases.
STT_HINTS=true
# Wake commands: words, then photos only for remember/ask, on their own fast models (Gemma 4 ~0.7 s words,
# ~1.3 s with 4 photos). Each call gets COMMAND_TIMEOUT_SECONDS, then the rules and saved item names decide.
GEMINI_COMMAND_MODEL=gemma-4-26b-a4b-it
GEMINI_COMMAND_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
COMMAND_TIMEOUT_SECONDS=4
VISION_PROVIDER=gemini

# Rate limits, shared by every server instance (app/limits.py, counted in Postgres). Keep them a
# little under your quotas: Gemini's are per Google Cloud project, AI Studio shows them
# (https://aistudio.google.com, "Rate limits"), and daily ones reset at midnight Pacific, as these
# do. *_RPM = per minute, *_RPD = per day, 0 = no cap. Over a cap: questions get a spoken "busy",
# memories are still saved, and other calls get a 429 with Retry-After. When Google answers 429
# or 503 anyway, every instance waits out the delay it asks for.
# Per text model, "model=per_minute/per_day", just under AI Studio's free tier for the lastscene
# project (Oct 17): 3.1 Flash Lite 15/500, 3 Flash 5/20, 3.8 Flash 5/20 (2.5 Flash isn't listed).
# GEMINI_RPM / GEMINI_RPD cover any model not listed. TTS caps apply to each TTS model (3/10 each).
GEMINI_MODEL_LIMITS=gemini-3.1-flash-lite=14/475,gemini-3-flash-preview=4/18,gemini-2.5-flash=4/18,gemini-3.8-flash=4/18
GEMINI_RPM=4
GEMINI_RPD=18
GEMINI_TTS_RPM=2
GEMINI_TTS_RPD=9
GEMINI_EMBEDDING_RPM=95
GEMINI_EMBEDDING_RPD=950
LIVE_TOKENS_PER_DAY=100
OPENAI_RPM=30
OPENAI_RPD=300
CLAUDE_RPM=20
CLAUDE_RPD=200
# Per caller: each wearable (memories, questions, live lookups), its vision uploads, and each
# caregiver's dashboard calls that use a model (search, summary).
DEVICE_RPM=20
DEVICE_RPD=1000
DEVICE_OBSERVATIONS_RPM=60
CAREGIVER_AI_RPM=30

# Only needed if a stage above is switched back to them
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
TTS_FORMAT=wav

# --- Wi-Fi positioning ---
# The wearable sends nearby Wi-Fi access points; the server asks Google's Geolocation
# API where that is (Google Cloud → enable "Geolocation API" → API key). Paid beyond the
# free tier; empty = no positions except a fixed HOME_LAT/LNG sent by the device.
GOOGLE_GEOLOCATION_API_KEY=
# Spend guard: Google calls allowed per calendar month (UTC); past it, Wi-Fi positioning pauses
# until next month. Keep it under Google's free monthly allowance. 0 = off.
GEOLOCATION_MONTHLY_LIMIT=5000
# Cached answers per access-point set are reused for this many days (free repeat lookups).
GEOLOCATION_CACHE_DAYS=30

# Name public places ("Starbucks, Reitz Union") on the dashboard with Gemini's Grounding with
# Google Maps (uses GEMINI_API_KEY). 5,000 free requests a month, then billed: off by default.
# Only places a household marked public are sent, in the background, cached by position.
MAPS_GROUNDING=false
# At most this many calls a day across the app (50 x 31 days stays under the free 5,000).
MAPS_DAILY_LIMIT=50
MAPS_CACHE_DAYS=180

# --- Vision pipeline observations ---
# Controlled m960d laptop demo: override to 0.05 on the backend; keep Maybe at 0.5.
# This filter affects all devices/labels. See ../docs/bridge-integration.md.
MIN_DETECTION_CONFIDENCE=0.35
MAYBE_CONFIDENCE=0.5
OBSERVATION_MIN_INTERVAL_SECONDS=2
# Last-seen frame per item; 72 = same as memories, 720 = the proposed 30 days
LAST_SEEN_RETENTION_HOURS=72

# --- raia frame context (optional) ---
# When the camera sees one of the user's items (a Teach item or alias, or one named in a spoken memory)
# at RAIA_MIN_CONFIDENCE or more (the detector's score in an observation, or a wake command's photo check),
# the frame goes to a raia agent (api.raia2.com) after the response, at most once per item every
# RAIA_COOLDOWN_MINUTES. Its JSON context is saved as a memory "LastScene: <summary>" with the item's
# place indexed. Empty RAIA_AGENT_KEY = off. The conversation API takes only the agent key.
RAIA_AGENT_KEY=
RAIA_ORG_KEY=
RAIA_MIN_CONFIDENCE=0.5
RAIA_COOLDOWN_MINUTES=30

# --- Serverless (Vercel) ---
# false = enrich before responding (safer when the host may freeze after a response)
ENRICH_IN_BACKGROUND=true
# Vercel Cron sends this as a bearer token to /api/v1/admin/purge
CRON_SECRET=

# --- Data lifecycle ---
RETENTION_HOURS=72
